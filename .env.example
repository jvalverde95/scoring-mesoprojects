# ============================================================
# NEXUS · Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.
# En Vercel/Azure, define estas variables en el panel de configuración.
# ============================================================

# ── Servidor ──
PORT=3000
APP_BASE_URL=http://localhost:3000

# ── Base de datos: elige el proveedor ──
# 'memory' (por defecto, sin BD) | 'github' (almacén actual) | 'azure-sql' (producción)
DB_PROVIDER=memory

# ── Almacén actual en GitHub (si DB_PROVIDER=github) ──
GITHUB_TOKEN=
GITHUB_REPO=usuario/repositorio
GITHUB_BRANCH=main
NEXUS_SHARE_KEY=

# ── Azure SQL Database (si DB_PROVIDER=azure-sql) ──
AZURE_SQL_SERVER=miservidor.database.windows.net
AZURE_SQL_DATABASE=nexus
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# ── Microsoft Entra ID · SSO (pendiente de crear el App Registration) ──
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Azure DevOps (proxy de la app; ya en uso) ──
# El PAT puede ir aquí como respaldo del servidor; la app también acepta uno por usuario.
ADO_PAT=
